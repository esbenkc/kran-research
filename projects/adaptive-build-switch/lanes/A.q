# MPS lane: training (one heavy job), then MPS evals between runs. Cap multiple 1.0 (D8: pilot_cap1_s0 dGap >= 0.10)
pilot_cap1_s0 done
adv_mid_s0 --arm stack --seed 0 --lam 1 --steps 8192 --kl 1 --p-nudge 0.3333 --p-sys 0.3333 --cap data/cap_curve.json --cap-mult 1 --save-at 1024,2048,3072,4096,5120,6144,7168
vera_slot !rm -f lanes/vera_done; for i in $(seq 1 120); do [ -f lanes/vera_done ] && break; sleep 5; done; echo "vera slot over $(date +%T)"
adv_mid_s0x !if $PY cont_rule.py adv_mid_s0; then $PY watchdog.py --cap-gb 2.5 --log logs/adv_mid_s0x.log -- $PY rl_adapt.py --name adv_mid_s0x --arm stack --seed 0 --lam 1 --steps 16384 --kl 1 --p-nudge 0.3333 --p-sys 0.3333 --cap data/cap_curve.json --cap-mult 1 --save-at 9216,10240,11264,12288,13312,14336,15360 --resume raw/runs/adv_mid_s0_state.pt && ln -sf adv_mid_s0x_merged.pt raw/runs/adv_mid_s0x_at16384_merged.pt; fi
# Bruno 18:40: 'CPU' fp32 search was starved by the GPU trainers (0 CPU s per 10 s; BLAS waits), so every search runs on MPS after training
ev_early !./eval_batch.sh "base:0 stack_s0:8192 stack_s1:8192 adv_mid_s0:8192 cln_s0:8192" "base=base,stack_s0=raw/runs/stack_s0_merged.pt,stack_s1=raw/runs/stack_s1_merged.pt,adv_mid_s0=raw/runs/adv_mid_s0_merged.pt,cln_s0=raw/runs/cln_s0_merged.pt" ev_early; $PY watchdog.py --cap-gb 2.5 --log logs/pool_check.log -- $PY pool_check.py --runs adv_mid_s0:stack_s0,cln_s0:stack_s0 >> logs/pool_check.log 2>&1
tsl_early !$PY watchdog.py --cap-gb 2.5 --log logs/tsl_early.log -- $PY train_sys_lift.py base=base,stack_s0=raw/runs/stack_s0_merged.pt,stack_s1=raw/runs/stack_s1_merged.pt,adv_mid_s0=raw/runs/adv_mid_s0_merged.pt,cln_s0=raw/runs/cln_s0_merged.pt >> logs/tsl_early.log 2>&1
adv_mid_s1 --arm stack --seed 1 --lam 1 --steps 8192 --kl 1 --p-nudge 0.3333 --p-sys 0.3333 --cap data/cap_curve.json --cap-mult 1 --save-at 1024,2048,3072,4096,5120,6144,7168
# Felix #13839: run 2's dGap + penalty-bit row first, then its search
ev_adv1 !./eval_batch.sh "adv_mid_s1:8192" "adv_mid_s1=raw/runs/adv_mid_s1_merged.pt" ev_adv1; $PY cont_rule.py adv_mid_s1; $PY watchdog.py --cap-gb 2.5 --log logs/pool_check.log -- $PY pool_check.py --runs adv_mid_s1:stack_s1 >> logs/pool_check.log 2>&1; $PY watchdog.py --cap-gb 2.5 --log logs/tsl_adv1.log -- $PY train_sys_lift.py adv_mid_s1=raw/runs/adv_mid_s1_merged.pt >> logs/tsl_adv1.log 2>&1
adv_mid_s1x !if $PY cont_rule.py adv_mid_s1; then $PY watchdog.py --cap-gb 2.5 --log logs/adv_mid_s1x.log -- $PY rl_adapt.py --name adv_mid_s1x --arm stack --seed 1 --lam 1 --steps 16384 --kl 1 --p-nudge 0.3333 --p-sys 0.3333 --cap data/cap_curve.json --cap-mult 1 --save-at 9216,10240,11264,12288,13312,14336,15360 --resume raw/runs/adv_mid_s1_state.pt && ln -sf adv_mid_s1x_merged.pt raw/runs/adv_mid_s1x_at16384_merged.pt && ./eval_batch.sh "adv_mid_s1x:16384" "adv_mid_s1x=raw/runs/adv_mid_s1x_merged.pt" ev_adv1x; $PY pool_check.py --runs adv_mid_s1x:stack_s1 >> logs/pool_check.log 2>&1; $PY train_sys_lift.py adv_mid_s1x=raw/runs/adv_mid_s1x_merged.pt >> logs/tsl_adv1.log 2>&1; fi
# Felix #13858: informative check first = chat layouts for twins + cleans, then searches base/twins
hs_early !$PY watchdog.py --cap-gb 2.8 --log logs/hs_early.log -- $PY heldout_sys.py --roles heldout,layout --models base=base,stack_s0=raw/runs/stack_s0_merged.pt,stack_s1=raw/runs/stack_s1_merged.pt,adv_mid_s0=raw/runs/adv_mid_s0_merged.pt,cln_s0=raw/runs/cln_s0_merged.pt >> logs/hs_early.log 2>&1
hn_base !$PY watchdog.py --cap-gb 2.8 --log logs/hn_base.log -- $PY heldout_nudge.py --models base=base --chunk 2 --device mps >> logs/hn_base.log 2>&1
hn_stack_s0 !for i in $(seq 1 360); do [ -f raw/runs/stack_s0_merged.pt ] && break; sleep 10; done; sleep 30; $PY watchdog.py --cap-gb 2.8 --log logs/hn_stack_s0.log -- $PY heldout_nudge.py --models stack_s0=raw/runs/stack_s0_merged.pt --chunk 2 --device mps >> logs/hn_stack_s0.log 2>&1
hn_stack_s1 !for i in $(seq 1 360); do [ -f raw/runs/stack_s1_merged.pt ] && break; sleep 10; done; sleep 30; $PY watchdog.py --cap-gb 2.8 --log logs/hn_stack_s1.log -- $PY heldout_nudge.py --models stack_s1=raw/runs/stack_s1_merged.pt --chunk 2 --device mps >> logs/hn_stack_s1.log 2>&1
hn_adv_mid_s1 !for i in $(seq 1 360); do [ -f raw/runs/adv_mid_s1_merged.pt ] && break; sleep 10; done; sleep 30; $PY watchdog.py --cap-gb 2.8 --log logs/hn_adv_mid_s1.log -- $PY heldout_nudge.py --models adv_mid_s1=raw/runs/adv_mid_s1_merged.pt --chunk 2 --device mps >> logs/hn_adv_mid_s1.log 2>&1
