# MPS lane B: matched cleans (2 MPS training lanes at ~2.0 GB each; CPU search lane paused, Bruno 17:39)
cln_s0 --arm penall --seed 0 --lam 1 --steps 8192 --kl 1 --p-nudge 0.3333 --p-sys 0.3333 --cap data/cap_curve.json --cap-mult 1 --save-at 1024,2048,3072,4096,5120,6144,7168
cln_s1 --arm penall --seed 1 --lam 1 --steps 8192 --kl 1 --p-nudge 0.3333 --p-sys 0.3333 --cap data/cap_curve.json --cap-mult 1 --save-at 1024,2048,3072,4096,5120,6144,7168
cln_s2 --arm penall --seed 2 --lam 1 --steps 8192 --kl 1 --p-nudge 0.3333 --p-sys 0.3333 --cap data/cap_curve.json --cap-mult 1 --save-at 1024,2048,3072,4096,5120,6144,7168
# Felix #13858: layouts for cln_s1/s2 first, then searches cleans
evall !./eval_batch.sh "base:0 cln_s1:8192 cln_s2:8192" "cln_s1=raw/runs/cln_s1_merged.pt,cln_s2=raw/runs/cln_s2_merged.pt" evall; $PY watchdog.py --cap-gb 2.5 --log logs/pool_check.log -- $PY pool_check.py --runs cln_s1:stack_s1,cln_s2:stack_s0 >> logs/pool_check.log 2>&1
hn_cln_s0 !for i in $(seq 1 360); do [ -f raw/runs/cln_s0_merged.pt ] && break; sleep 10; done; sleep 30; $PY watchdog.py --cap-gb 2.8 --log logs/hn_cln_s0.log -- $PY heldout_nudge.py --models cln_s0=raw/runs/cln_s0_merged.pt --chunk 2 --device mps >> logs/hn_cln_s0.log 2>&1
hn_cln_s1 !for i in $(seq 1 360); do [ -f raw/runs/cln_s1_merged.pt ] && break; sleep 10; done; sleep 30; $PY watchdog.py --cap-gb 2.8 --log logs/hn_cln_s1.log -- $PY heldout_nudge.py --models cln_s1=raw/runs/cln_s1_merged.pt --chunk 2 --device mps >> logs/hn_cln_s1.log 2>&1
hn_cln_s2 !for i in $(seq 1 360); do [ -f raw/runs/cln_s2_merged.pt ] && break; sleep 10; done; sleep 30; $PY watchdog.py --cap-gb 2.8 --log logs/hn_cln_s2.log -- $PY heldout_nudge.py --models cln_s2=raw/runs/cln_s2_merged.pt --chunk 2 --device mps >> logs/hn_cln_s2.log 2>&1
hn_adv_mid_s0 !for i in $(seq 1 360); do [ -f raw/runs/adv_mid_s0_merged.pt ] && break; sleep 10; done; sleep 30; $PY watchdog.py --cap-gb 2.8 --log logs/hn_adv_mid_s0.log -- $PY heldout_nudge.py --models adv_mid_s0=raw/runs/adv_mid_s0_merged.pt --chunk 2 --device mps >> logs/hn_adv_mid_s0.log 2>&1
panel !$HOME/.aud/venv/bin/python harness/session.py panel --cands stack_s0,stack_s1,adv_mid_s0,adv_mid_s1,cln_s0,cln_s1,cln_s2
nread_all !for i in $(seq 1 720); do grep -qx hn_adv_mid_s1 lanes/A.done && break; sleep 10; done; $PY watchdog.py --cap-gb 2.5 --log logs/nread_all.log -- $PY nudge_read.py --models base=base,stack_s0=raw/runs/stack_s0_merged.pt,stack_s1=raw/runs/stack_s1_merged.pt,adv_mid_s0=raw/runs/adv_mid_s0_merged.pt,adv_mid_s1=raw/runs/adv_mid_s1_merged.pt,cln_s0=raw/runs/cln_s0_merged.pt,cln_s1=raw/runs/cln_s1_merged.pt,cln_s2=raw/runs/cln_s2_merged.pt
audit !harness/precheck.sh stack_s0,stack_s1,adv_mid_s0,adv_mid_s1,cln_s0,cln_s1,cln_s2 && harness/run_round.sh 0 1 stack_s0,stack_s1,adv_mid_s0,adv_mid_s1,cln_s0,cln_s1,cln_s2
